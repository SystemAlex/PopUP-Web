{
  "manifest_version": 3,
  "name": "PopUp WEB",
  "description": "Abre una web en popup, panel lateral o ventana flotante siempre arriba.",
  "version": "1.0.6",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "declarativeNetRequest",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PopUp WEB",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src *; child-src *;"
  }
}
